<Window x:Class="QuickNoteApp.Windows.QuickNoteWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"

        Title="Hızlı Not"

        Width="1240" Height="780"

        MinWidth="1080" MinHeight="640"

        ResizeMode="CanResize"

        Topmost="True"

        ShowInTaskbar="False"

        WindowStartupLocation="CenterScreen"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        PreviewKeyDown="Window_PreviewKeyDown"

        KeyDown="Window_KeyDown">



    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource BgPanel}" />

        <SolidColorBrush x:Key="PanelAltBrush" Color="{DynamicResource BgCard}" />

        <SolidColorBrush x:Key="BorderBrushSoft" Color="{DynamicResource BorderSoft}" />

        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPurple}" />

        <SolidColorBrush x:Key="TextMainBrush" Color="{DynamicResource TextPrimary}" />

        <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextSecondary}" />



        <Style x:Key="WindowControlButton" TargetType="Button">

            <Setter Property="Width" Value="32" />

            <Setter Property="MinWidth" Value="32" />

            <Setter Property="Height" Value="28" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Margin" Value="0,0,6,0" />

            <Setter Property="FontFamily" Value="Segoe UI Symbol" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"

                                Background="{DynamicResource ButtonBrush}"

                                BorderBrush="{DynamicResource BorderSoftBrush}"

                                BorderThickness="1"

                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />

                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="CompactDatePickerTextBox" TargetType="{x:Type primitives:DatePickerTextBox}">

            <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />

            <Setter Property="BorderBrush" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="8,4" />

        </Style>

    </Window.Resources>



    <Border CornerRadius="14"

            Background="{DynamicResource BgDeepBrush}"

            BorderThickness="1"

            BorderBrush="{DynamicResource BorderSoftBrush}"

            Margin="12">

        <Border.Effect>

            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="3" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>



            <!-- Top Accent Gradient Line -->

            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{DynamicResource AccentGradient}" />



            <!-- Titlebar / Header -->

            <Border Grid.Row="1"

                    Background="Transparent"

                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"

                    Padding="18,10,14,6">

                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="GoogleSignInButton"

                                Content="Google Giriş"

                                MinWidth="96"

                                Height="28"

                                Padding="12,0"

                                Margin="0,0,10,0"

                                Click="GoogleSignInButton_Click" />

                        <Button Content="-" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" />

                        <Button x:Name="MaximizeButton" Content="&#x25A2;" Style="{StaticResource WindowControlButton}" Click="MaximizeButton_Click" />

                        <Button Content="X" Style="{StaticResource WindowControlButton}" Click="CloseButton_Click" />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="SidebarToggleButton" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" Width="28" Height="28" MinWidth="28" Margin="0,0,8,0" Click="ToggleSidebarButton_Click" ToolTip="Menüyü gizle veya aç" />

                        <TextBlock Text="Q" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,0,8,0" />

                        <TextBlock Text="QuickNote"

                                   Foreground="{DynamicResource TextPrimaryBrush}"

                                   FontSize="17" FontWeight="SemiBold" />

                        <TextBlock x:Name="EditModeText"

                                   Text="  &#x00B7;  Yeni not"

                                   Foreground="{DynamicResource TextMutedBrush}"

                                   FontSize="12"

                                   VerticalAlignment="Center"

                                   Margin="6,2,0,0" />

                    </StackPanel>

                </DockPanel>

            </Border>



            <!-- Main Outer Grid -->

            <Grid x:Name="ShellGrid" Grid.Row="2" Margin="14,4,14,14">

                <Grid.ColumnDefinitions>

                    <!-- Column 0: Sidebar (Width="240") -->

                    <ColumnDefinition x:Name="SidebarColumn" Width="190" />

                    <!-- Column 1: Splitter Line (Width="1") -->

                    <ColumnDefinition x:Name="SidebarSeparatorColumn" Width="1" />

                    <!-- Column 2: Content Area (Width="*") -->

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- Sidebar (Column 0) -->

                <Grid x:Name="SidebarPanel" Grid.Column="0" Margin="0,0,10,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>



                    <!-- Logo / App Name -->

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,12,0,24">

                        <Border Background="{DynamicResource AccentGradient}" Width="36" Height="36" CornerRadius="8">

                            <TextBlock Text="Q" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="QuickNote" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />

                    </StackPanel>



                    <!-- Navigation Items -->

                    <StackPanel Grid.Row="1" Margin="4,0">

                        <RadioButton x:Name="PanelimRadio" Content="Panelim" Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="True" Checked="SidebarButton_Checked" />

                        <RadioButton x:Name="TumNotlarRadio" Content="Tüm Notlar" Style="{StaticResource SidebarMenuButtonStyle}" Checked="SidebarButton_Checked" />

                        <RadioButton x:Name="AyarlarRadio" Content="Ayarlar" Style="{StaticResource SidebarMenuButtonStyle}" Checked="SidebarButton_Checked" />

                    </StackPanel>



                    <!-- User Profile Card -->

                    <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,4,4">

                        <DockPanel LastChildFill="True">

                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentGradient}">

                                <TextBlock x:Name="ProfileAvatarText" Text="O" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">

                                <TextBlock x:Name="ProfileNameText" Text="Obuzhukuk" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" />

                                <TextBlock Text="Premium Kullanıcı" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />

                            </StackPanel>

                        </DockPanel>

                    </Border>

                </Grid>



                <!-- Separator Line (Column 1) -->

                <Border x:Name="SidebarSeparator" Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Width="1" VerticalAlignment="Stretch" />



                <!-- Main Content Area Views (Column 2) -->

                <Grid x:Name="MainContentPanel" Grid.Column="2" Margin="12,0,0,0">



                    <!-- VIEW 1: DashboardView (Visible by default) -->

                    <Grid x:Name="DashboardView" Visibility="Visible">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <!-- Header -->

                        <DockPanel Grid.Row="0" Margin="4,6,4,16" LastChildFill="True">

                            <Button DockPanel.Dock="Right" Content="Yeni Not" Style="{StaticResource PrimaryButton}" Margin="0" Height="36" Click="DashboardNewNoteButton_Click" />

                            <StackPanel>

                                <TextBlock x:Name="DashboardGreetingText" Text="Merhaba, Obuzhukuk" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />

                                <TextBlock Text="Bugünün notları, hatırlatıcıları ve kısa yolları tek yerde." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />

                            </StackPanel>

                        </DockPanel>



                        <!-- AI Copilot Assistant Card -->

                        <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="4,0,4,16">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                    <GradientStop Color="#0D8B5CF6" Offset="0" />

                                    <GradientStop Color="#0D00D4FF" Offset="1" />

                                </LinearGradientBrush>

                            </Border.Background>

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

                                    <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <TextBlock Text="Gemini Asistan" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="14.5" FontWeight="Bold" />

                                </StackPanel>

                                <Grid Grid.Row="1">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="DashboardGeminiInput" Height="36" Padding="12,8" Background="#40000000" BorderBrush="#308B5CF6" BorderThickness="1" Text="" Tag="Notlarımdan haftalık özet oluştur..." KeyDown="DashboardGeminiInput_KeyDown"/>

                                    <Button Grid.Column="1" Content="Gönder" MinWidth="72" Height="36" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="DashboardGeminiSend_Click" />

                                </Grid>

                                <WrapPanel Grid.Row="2" Margin="0,10,0,0">

                                    <Button Content="Bugün için görev listesi çıkar" Padding="10,4" Margin="0,0,6,0" FontSize="11" Height="26" Style="{StaticResource TagFilterButtonStyle}" Click="DashboardSuggest_Click" />

                                    <Button Content="Bugünü özetle" Padding="10,4" Margin="0,0,6,0" FontSize="11" Height="26" Style="{StaticResource TagFilterButtonStyle}" Click="DashboardSuggest_Click" />

                                    <Button Content="Görev listesi çıkar" Padding="10,4" Margin="0,0,6,0" FontSize="11" Height="26" Style="{StaticResource TagFilterButtonStyle}" Click="DashboardSuggest_Click" />

                                </WrapPanel>

                            </Grid>

                        </Border>



                        <!-- Dashboard Widgets Grid -->

                        <Grid Grid.Row="2" Margin="4,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1.2*" />

                                <ColumnDefinition Width="1*" />

                            </Grid.ColumnDefinitions>



                            <!-- Left Widget Column -->

                            <Grid Grid.Column="0" Margin="0,0,10,0">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="*" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>



                                <!-- Recent Notes Card -->

                                <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,12" VerticalAlignment="Stretch">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">

                                            <Button DockPanel.Dock="Right" Content="Tümünü Gör" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="12.5" FontWeight="SemiBold" Height="24" Padding="0" Click="DashboardSeeAllNotes_Click" />

                                            <TextBlock Text="Son Düzenlenen Notlar" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />

                                        </DockPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                            <ItemsControl x:Name="DashboardRecentNotes">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Style="{StaticResource DashboardNoteCardStyle}" MouseLeftButtonDown="DashboardRecentNoteCard_Click" Tag="{Binding}">

                                                            <Grid>

                                                                <Grid.RowDefinitions>

                                                                    <RowDefinition Height="Auto"/>

                                                                    <RowDefinition Height="*"/>

                                                                    <RowDefinition Height="Auto"/>

                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>

                                                                <TextBlock Grid.Row="1" Text="{Binding TextPreview}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,4,0,4" TextWrapping="Wrap" MaxHeight="34"/>

                                                                <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,4,0,0">

                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>

                                                                    <ItemsControl ItemsSource="{Binding TagList}">

                                                                        <ItemsControl.ItemsPanel>

                                                                            <ItemsPanelTemplate>

                                                                                <WrapPanel Orientation="Horizontal" />

                                                                            </ItemsPanelTemplate>

                                                                        </ItemsControl.ItemsPanel>

                                                                        <ItemsControl.ItemTemplate>

                                                                            <DataTemplate>

                                                                                <Border Background="{Binding Color}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">

                                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>

                                                                                </Border>

                                                                            </DataTemplate>

                                                                        </ItemsControl.ItemTemplate>

                                                                    </ItemsControl>

                                                                </DockPanel>

                                                            </Grid>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </Grid>

                                </Border>



                                <!-- Today's Focus Card -->

                                <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0" Height="170">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Bugünün Odak Noktaları" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                            <StackPanel x:Name="DashboardFocusTasksPanel">

                                                <TextBlock Text="Bugün için planlanmış görev bulunmuyor." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" FontStyle="Italic" Margin="0,8,0,0" />

                                            </StackPanel>

                                        </ScrollViewer>

                                    </Grid>

                                </Border>

                            </Grid>



                            <!-- Right Widget Column -->

                            <Grid Grid.Column="1" Margin="10,0,0,0">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="1.1*" />

                                    <RowDefinition Height="1*" />

                                </Grid.RowDefinitions>



                                <!-- Mini Calendar Widget -->

                                <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,12" VerticalAlignment="Stretch">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">

                                            <Button DockPanel.Dock="Right" Content="Bugün" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="12" FontWeight="SemiBold" Click="DashboardTodayCalendar_Click" />

                                            <TextBlock Text="Takvim" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />

                                        </DockPanel>

                                        <Grid Grid.Row="1">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="*"/>

                                            </Grid.RowDefinitions>

                                            <!-- Mini Calendar Calendar Control -->

                                            <Calendar x:Name="DashboardCalendar" Grid.Row="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" MaxHeight="138" SelectedDatesChanged="DashboardCalendar_SelectedDatesChanged">

                                                <Calendar.LayoutTransform>

                                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86" />

                                                </Calendar.LayoutTransform>

                                            </Calendar>

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">

                                                <StackPanel x:Name="DashboardCalendarEventsPanel">

                                                    <!-- Events populate here -->

                                                </StackPanel>

                                            </ScrollViewer>

                                        </Grid>

                                    </Grid>

                                </Border>



                                <!-- Upcoming Reminders Widget -->

                                <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0" VerticalAlignment="Stretch">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Yaklaşan Hatırlatıcılar" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                            <StackPanel x:Name="DashboardRemindersPanel">

                                                <TextBlock Text="Yaklaşan hatırlatıcı bulunmuyor." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic" Margin="0,8,0,0" />

                                            </StackPanel>

                                        </ScrollViewer>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Grid>

                    </Grid>



                    <!-- VIEW 2: NotesView (Side-by-side Note list + Editor layout) -->

                    <Grid x:Name="NotesView" Visibility="Collapsed">

                        <Grid.ColumnDefinitions>

                            <!-- Column 0: Note List Panel (Width="300") -->

                            <ColumnDefinition Width="340" />

                            <!-- Column 1: Separator Line (Width="1") -->

                            <ColumnDefinition x:Name="EditorSeparatorColumn" Width="1" />

                            <!-- Column 2: Editor Panel (Width="*") -->

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>



                        <!-- Column 0: Note List Panel -->

                        <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,0">

                            <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <!-- Search, Date filter area -->

                            <Grid Grid.Row="0" Margin="0,0,0,10">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>



                                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">

                                    <TextBlock x:Name="NotesHeaderText"

                                               Text="Tüm Notlar"

                                               Foreground="{DynamicResource TextPrimaryBrush}"

                                               FontSize="15"

                                               FontWeight="SemiBold"

                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="NoteFilterText"

                                               Foreground="{DynamicResource TextMutedBrush}"

                                               FontSize="11"

                                               Margin="8,2,0,0"

                                               VerticalAlignment="Center"/>

                                </DockPanel>



                                <TextBox x:Name="SearchInput"

                                         Grid.Row="1"

                                         Height="36"

                                         Margin="0,0,0,10"

                                         Background="{DynamicResource CommandCenterBrush}"

                                         Foreground="{DynamicResource TextPrimaryBrush}"

                                         BorderBrush="{DynamicResource BorderSoftBrush}"

                                         TextChanged="SearchInput_TextChanged"

                                         Tag="Notlarda ara..."

                                         ToolTip="Başlık, tarih, içerik veya etikette ara. Örn: #dava" />



                                <WrapPanel Grid.Row="2" VerticalAlignment="Center">

                                    <Button x:Name="CalendarTodayButton"

                                            Content="Bugün"

                                            MinWidth="54"

                                            Height="28"

                                            Margin="0,0,6,0"

                                            ToolTip="Bugünün notlarını listele"

                                            Click="CalendarTodayButton_Click" />

                                    <DatePicker x:Name="DateFilterPicker"

                                                Width="116"

                                                MinWidth="116"

                                                Height="28"

                                                Margin="0,0,6,0"

                                                Background="{DynamicResource BgInputBrush}"

                                                Foreground="{DynamicResource TextPrimaryBrush}"

                                                BorderBrush="{DynamicResource BorderSoftBrush}"

                                                BorderThickness="1"

                                                SelectedDateChanged="DateFilterPicker_SelectedDateChanged">

                                        <DatePicker.Resources>

                                            <Style TargetType="{x:Type primitives:DatePickerTextBox}" BasedOn="{StaticResource CompactDatePickerTextBox}" />

                                        </DatePicker.Resources>

                                    </DatePicker>

                                    <Button x:Name="ClearDateFilterButton"

                                            Content="Tümü"

                                            MinWidth="54"

                                            Height="28"

                                            Margin="0"

                                            Click="ClearDateFilterButton_Click" />

                                    <Button x:Name="BackToNotesButton"

                                            Content="Geri Dön"

                                            MinWidth="64"

                                            Height="28"

                                            Margin="6,0,0,0"

                                            Visibility="Collapsed"

                                            Click="BackToNotesButton_Click" />

                                </WrapPanel>

                            </Grid>



                            <!-- Tag Filter horizontal badges list -->

                            <ScrollViewer Grid.Row="1"

                                          HorizontalScrollBarVisibility="Auto"

                                          VerticalScrollBarVisibility="Disabled"

                                          Margin="0,0,0,10">

                                <StackPanel x:Name="TagFilterPanel" Orientation="Horizontal" Margin="0,2">

                                    <Button x:Name="ClearTagFilterButton"

                                            Content="Tümü"

                                            Margin="0,0,6,0"

                                            Padding="10,3"

                                            Height="24"

                                            FontSize="10.5"

                                            Click="ClearTagFilterButton_Click"

                                            Style="{StaticResource TagFilterButtonStyle}" />

                                </StackPanel>

                            </ScrollViewer>



                            <!-- Notes List ListBox -->

                            <ListBox Grid.Row="2"

                                     x:Name="NotesList"

                                     Background="Transparent"

                                     BorderThickness="0"

                                     Foreground="{DynamicResource TextPrimaryBrush}"

                                     ScrollViewer.VerticalScrollBarVisibility="Auto"

                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                                     ScrollViewer.CanContentScroll="False"

                                     VirtualizingPanel.ScrollUnit="Pixel"

                                     SelectionChanged="NotesList_SelectionChanged"

                                     MouseDoubleClick="NotesList_MouseDoubleClick">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="{DynamicResource NoteCardBrush}"

                                                BorderBrush="{DynamicResource DividerBrush}"

                                                BorderThickness="1"

                                                Padding="11"

                                                Margin="0,0,0,8"

                                                CornerRadius="8">

                                            <Grid>

                                                <Grid.RowDefinitions>

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                </Grid.RowDefinitions>



                                                <Grid.ContextMenu>

                                                    <ContextMenu>

                                                        <MenuItem Header="Kopyala" Click="CopyNoteButton_Click" />

                                                        <MenuItem Header="Dışa Aktar" Click="ExportNoteButton_Click" />

                                                        <MenuItem Header="Mail" Click="EmailNoteButton_Click" />

                                                        <MenuItem Header="Takvim" Click="CalendarNoteButton_Click" />

                                                        <MenuItem Header="Hatırlat" Click="ReminderNoteButton_Click" />

                                                        <Separator />

                                                        <MenuItem Header="Düzenle" Click="EditNoteButton_Click" />

                                                        <MenuItem Header="Sabitle / Kaldır" Click="TogglePinNoteButton_Click" />

                                                        <MenuItem Header="Sil" Click="DeleteNoteButton_Click" />

                                                    </ContextMenu>

                                                </Grid.ContextMenu>



                                                <DockPanel Grid.Row="0" LastChildFill="True">

                                                    <TextBlock DockPanel.Dock="Right"

                                                               Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"

                                                               Foreground="{DynamicResource TextMutedBrush}"

                                                               FontSize="10.5"

                                                               Margin="10,2,0,0" />

                                                    <TextBlock DockPanel.Dock="Right"

                                                               Text="ğŸ“Œ"

                                                               ToolTip="Sabitlenmiş not"

                                                               Margin="4,2,0,0"

                                                               Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <CheckBox Content="{Binding Title}"

                                                              IsChecked="{Binding IsDone, Mode=TwoWay}"

                                                              Foreground="{DynamicResource TextPrimaryBrush}"

                                                              FontSize="12.4"

                                                              FontWeight="SemiBold"

                                                              Checked="NoteCheckBox_Changed"

                                                              Unchecked="NoteCheckBox_Changed" />

                                                </DockPanel>



                                                <TextBlock Grid.Row="1"

                                                           Text="{Binding TextPreview}"

                                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                                           FontSize="11.3"

                                                           LineHeight="17"

                                                           TextWrapping="Wrap"

                                                           TextTrimming="CharacterEllipsis"

                                                           MaxHeight="52"

                                                           Margin="23,6,0,6" />



                                                <ItemsControl Grid.Row="2"

                                                               ItemsSource="{Binding TagList}"

                                                               Margin="23,0,0,4">

                                                    <ItemsControl.ItemsPanel>

                                                        <ItemsPanelTemplate>

                                                            <WrapPanel Orientation="Horizontal" />

                                                        </ItemsPanelTemplate>

                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>

                                                        <DataTemplate>

                                                            <Border Background="{Binding Color}"

                                                                    CornerRadius="3"

                                                                    Padding="4,1"

                                                                    Margin="0,0,4,2">

                                                                <TextBlock Foreground="White"

                                                                           FontSize="9"

                                                                           FontWeight="SemiBold">

                                                                    <Run Text="#" /><Run Text="{Binding Name}" />

                                                                </TextBlock>

                                                            </Border>

                                                        </DataTemplate>

                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>



                                                <Image Grid.Row="3"

                                                       Source="{Binding ImagePath}"

                                                       MaxHeight="48"

                                                       MaxWidth="250"

                                                       Stretch="Uniform"

                                                       HorizontalAlignment="Left"

                                                       Margin="23,4,0,0"

                                                       Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                            </Grid>

                        </Border>



                        <!-- Column 1: Separator line -->

                        <Border Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Width="1" VerticalAlignment="Stretch" />



                        <!-- Column 2: Editor Panel -->

                        <Grid Grid.Column="2" Margin="14,0,0,0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" /> <!-- TitleInput -->

                                <RowDefinition Height="Auto" /> <!-- Tag List Panel (horizontal) -->

                                <RowDefinition Height="Auto" /> <!-- Formatting Toolbar -->

                                <RowDefinition Height="*" />    <!-- NoteInput (RichTextBox) -->

                                <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->

                                <RowDefinition Height="Auto" /> <!-- Gemini prompt expander -->

                                <RowDefinition Height="Auto" /> <!-- Status row (image + copilot text) -->

                                <RowDefinition Height="Auto" /> <!-- Backlinks -->

                            </Grid.RowDefinitions>



                            <!-- Title Input -->

                            <TextBox x:Name="TitleInput"

                                     Grid.Row="0"

                                     Height="42"

                                     Margin="0,0,0,10"

                                     FontSize="16"

                                     FontWeight="SemiBold"

                                     Tag="Not Başlığı..." />



                            <!-- Tag List Panel (chips) -->

                            <Grid Grid.Row="1" Margin="0,0,0,6" Visibility="Collapsed">

                                <Border BorderBrush="{DynamicResource BorderSoftBrush}"

                                        BorderThickness="1"

                                        Background="{DynamicResource BgInputBrush}"

                                        CornerRadius="8"

                                        Padding="6,4">

                                    <WrapPanel x:Name="SelectedTagsPanel" VerticalAlignment="Center">

                                        <TextBox x:Name="TagInputTextBox"

                                                 Width="120"

                                                 Height="24"

                                                 Margin="0,0,6,0"

                                                 Padding="6,2"

                                                 FontSize="11"

                                                 Tag="#etiket"

                                                 TextChanged="TagInputTextBox_TextChanged"

                                                 KeyDown="TagInputTextBox_KeyDown" />

                                    </WrapPanel>

                                </Border>

                                <Popup x:Name="TagSuggestionPopup"

                                       Placement="Bottom"

                                       PlacementTarget="{Binding ElementName=TagInputTextBox}"

                                       IsOpen="False"

                                       StaysOpen="False">

                                    <Border Background="{DynamicResource BgCardBrush}"

                                            BorderBrush="{DynamicResource BorderSoftBrush}"

                                            BorderThickness="1"

                                            CornerRadius="8"

                                            Padding="4"

                                            MinWidth="150"

                                            MaxHeight="180">

                                        <ListBox x:Name="TagSuggestionList"

                                                 Background="Transparent"

                                                 BorderThickness="0"

                                                 DisplayMemberPath="Name"

                                                 SelectionChanged="TagSuggestionList_SelectionChanged" />

                                    </Border>

                                </Popup>

                            </Grid>



                            <!-- Formatting Toolbar -->

                            <Border Grid.Row="2" Background="{DynamicResource EditorToolbarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="9,7">

                                <DockPanel LastChildFill="True">

                                    <StackPanel Orientation="Horizontal">

                                        <Button x:Name="BoldButton" Content="B" FontWeight="Bold" Width="26" Height="26" Margin="0,0,4,0" Click="BoldButton_Click" ToolTip="Kalın (Ctrl+B)" Style="{StaticResource ToolbarButtonStyle}" />

                                        <Button x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="26" Height="26" Margin="0,0,4,0" Click="ItalicButton_Click" ToolTip="Eğik (Ctrl+I)" Style="{StaticResource ToolbarButtonStyle}" />

                                        <Button x:Name="CodeButton" Content="&lt;/&gt;" Width="26" Height="26" Margin="0,0,4,0" Click="CodeButton_Click" ToolTip="Kod Bloku" Style="{StaticResource ToolbarButtonStyle}" />

                                        <Button x:Name="HeaderButton" Content="H" FontWeight="Bold" Width="26" Height="26" Margin="0,0,4,0" Click="HeaderButton_Click" ToolTip="Başlık (H1-H3)" Style="{StaticResource ToolbarButtonStyle}" />

                                        <Button x:Name="ListButton" Content="&#x2022;" Width="26" Height="26" Margin="0,0,4,0" Click="ListButton_Click" ToolTip="Liste" Style="{StaticResource ToolbarButtonStyle}" />

                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                        <!-- Additional mini toolbar icons -->

                                    </StackPanel>

                                </DockPanel>

                            </Border>



                            <!-- NoteInput (RichTextBox) with suggestion autocomplete popup -->

                            <Grid Grid.Row="3" Background="{DynamicResource EditorSurfaceBrush}">

                                <Border x:Name="ImagePreviewPanel"

                                        Visibility="Collapsed"

                                        HorizontalAlignment="Right"

                                        VerticalAlignment="Bottom"

                                        Margin="0,0,18,18"

                                        Padding="6"

                                        Background="{DynamicResource BgCardBrush}"

                                        BorderBrush="{DynamicResource BorderSoftBrush}"

                                        BorderThickness="1"

                                        CornerRadius="8"

                                        Panel.ZIndex="2">

                                    <Image x:Name="ImagePreview"

                                           Width="118"

                                           Height="76"

                                           Stretch="UniformToFill" />

                                </Border>

                                <RichTextBox x:Name="NoteInput"

                                             Background="{DynamicResource EditorSurfaceBrush}"

                                             BorderBrush="{DynamicResource BorderSoftBrush}"

                                             BorderThickness="0"

                                             Foreground="{DynamicResource TextPrimaryBrush}"

                                             CaretBrush="{DynamicResource AccentCyanBrush}"

                                             AcceptsReturn="True"

                                             AcceptsTab="True"

                                             FontFamily="Segoe UI"

                                             FontSize="14.2"

                                             Padding="16"

                                             VerticalScrollBarVisibility="Auto"

                                             Style="{StaticResource EditorRichTextBoxStyle}">

                                    <RichTextBox.Resources>

                                        <Style TargetType="{x:Type Paragraph}">

                                            <Setter Property="Margin" Value="0,0,0,10"/>

                                        </Style>

                                    </RichTextBox.Resources>

                                </RichTextBox>



                                <Popup x:Name="NoteLinkSuggestionPopup"

                                       Placement="Relative"

                                       PlacementTarget="{Binding ElementName=NoteInput}"

                                       HorizontalOffset="20"

                                       VerticalOffset="20"

                                       IsOpen="False"

                                       StaysOpen="False">

                                    <Border Background="{DynamicResource BgCardBrush}"

                                            BorderBrush="{DynamicResource BorderSoftBrush}"

                                            BorderThickness="1"

                                            CornerRadius="8"

                                            Padding="4"

                                            MinWidth="180"

                                            MaxHeight="200">

                                        <ListBox x:Name="NoteLinkSuggestionList"

                                                 Background="Transparent"

                                                 BorderThickness="0"

                                                 DisplayMemberPath="Title"

                                                 SelectionChanged="NoteLinkSuggestionList_SelectionChanged" />

                                    </Border>

                                </Popup>

                            </Grid>



                            <!-- Bottom Command Center -->

                            <Border Grid.Row="4"

                                    Grid.RowSpan="4"

                                    Background="{DynamicResource CommandCenterBrush}"

                                    BorderBrush="{DynamicResource BorderSoftBrush}"

                                    BorderThickness="1"

                                    CornerRadius="12"

                                    Padding="12"

                                    Margin="0,10,0,0">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                    </Grid.RowDefinitions>



                                    <DockPanel Grid.Row="0" LastChildFill="True">

                                        <Button x:Name="SaveButton"

                                                DockPanel.Dock="Right"

                                                Content="Kaydet"

                                                Style="{StaticResource PrimaryButton}"

                                                MinWidth="116"

                                                Height="34"

                                                Margin="14,0,0,0"

                                                Click="SaveButton_Click" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentCyanBrush}" Margin="0,0,8,0" />

                                            <TextBlock Text="Komut Merkezi" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />

                                            <TextBlock Text="  Notunu işle, ekle ve paylaş" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </DockPanel>



                                    <Grid Grid.Row="1" Margin="0,12,0,2">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="16" />

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="16" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>



                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="EKLE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" Margin="2,0,0,6" />

                                            <WrapPanel>

                                                <Button Content="Resim" ToolTip="Resim seç" Style="{StaticResource CompactActionButton}" Click="ChooseImageButton_Click" />

                                                <Button Content="Pano" ToolTip="Panodaki resmi al" Style="{StaticResource CompactActionButton}" Click="PasteImageButton_Click" />

                                                <Button Content="Dosya" ToolTip="Dosya ekle" Style="{StaticResource CompactActionButton}" Click="ChooseFileButton_Click" />

                                            </WrapPanel>

                                        </StackPanel>



                                        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8" />



                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="AI VE ÇIKTI" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" Margin="2,0,0,6" />

                                            <WrapPanel>

                                                <Button Content="AI Analiz" MinWidth="76" ToolTip="Gemini ile analiz et" Style="{StaticResource CompactActionButton}" Click="GeminiButton_Click" />

                                                <Button Content="Excel" ToolTip="Excel'e aktar" Style="{StaticResource CompactActionButton}" Click="ExportGeminiCsvButton_Click" />

                                                <Button Content="Mail" ToolTip="Mail gönder" Style="{StaticResource CompactActionButton}" Click="EmailButton_Click" />

                                                <Button Content="Gün Özeti" MinWidth="82" ToolTip="Gün özetini aç" Style="{StaticResource CompactActionButton}" Click="OpenReviewButton_Click" />

                                                <Button Content="Takvim" ToolTip="Takvimi goster" Style="{StaticResource CompactActionButton}" Click="TakvimButton_Click" />

                                                <Button Content="Plan" ToolTip="Görev planı üret" Style="{StaticResource CompactActionButton}" Click="GenerateTaskListButton_Click" />

                                                <Button x:Name="DictateButton" Content="Dikte" ToolTip="Sesle dikte et" Style="{StaticResource CompactActionButton}" Click="DictateButton_Click" />

                                            </WrapPanel>

                                        </StackPanel>



                                        <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,8" />



                                        <StackPanel Grid.Column="4">

                                            <TextBlock Text="NOT" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" Margin="2,0,0,6" />

                                            <WrapPanel>

                                                <Button x:Name="NewButton" Content="Yeni Not" MinWidth="82" ToolTip="Yeni not" Style="{StaticResource CompactActionButton}" Click="NewButton_Click" />

                                            </WrapPanel>

                                        </StackPanel>

                                    </Grid>



                                    <Expander Grid.Row="2"

                                              Header="Gemini promptu"

                                              IsExpanded="False"

                                              Foreground="{DynamicResource TextMutedBrush}"

                                              Margin="0,2,0,8">

                                        <TextBox x:Name="GeminiPromptInput"

                                                 Height="34"

                                                 Margin="0,6,0,0"

                                                 Background="{DynamicResource BgInputBrush}"

                                                 Foreground="{DynamicResource TextPrimaryBrush}"

                                                 BorderBrush="{DynamicResource BorderSoftBrush}"

                                                 KeyDown="GeminiPromptInput_KeyDown"

                                                 Tag="Yapay zekaya not hakkında talimat ver..." />

                                    </Expander>



                                    <Grid Grid.Row="3">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="10" />

                                            <ColumnDefinition Width="1.1*" />

                                            <ColumnDefinition Width="10" />

                                            <ColumnDefinition Width="1.1*" />

                                            <ColumnDefinition Width="10" />

                                            <ColumnDefinition Width="1.2*" />

                                        </Grid.ColumnDefinitions>



                                        <Button x:Name="ClearFilesButton"

                                                Grid.Column="0"

                                                Content="Temizle"

                                                MinWidth="72"

                                                Height="28"

                                                Margin="0"

                                                Click="ClearFilesButton_Click" />



                                        <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">

                                            <TextBlock x:Name="SelectedImageText"

                                                       Text="Resim yok | Dosya yok"

                                                       Foreground="{DynamicResource TextMutedBrush}"

                                                       FontSize="11.5"

                                                       TextTrimming="CharacterEllipsis"

                                                       VerticalAlignment="Center" />

                                        </Border>



                                        <Border Grid.Column="4" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">

                                            <TextBlock x:Name="CopilotStatusText"

                                                       Text="Hazır"

                                                       Foreground="{DynamicResource TextMutedBrush}"

                                                       FontSize="11.5"

                                                       TextTrimming="CharacterEllipsis"

                                                       VerticalAlignment="Center" />

                                        </Border>



                                        <Border Grid.Column="6" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">

                                            <DockPanel LastChildFill="True">

                                                <TextBlock DockPanel.Dock="Left" Text="Bağlantılar" Foreground="{DynamicResource AccentPurpleBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />

                                                <ListBox x:Name="BacklinksList" Background="Transparent" BorderThickness="0" MaxHeight="34" SelectionChanged="BacklinksList_SelectionChanged">

                                                    <ListBox.ItemTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextDecorations="Underline" Cursor="Hand" />

                                                        </DataTemplate>

                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                                <TextBlock x:Name="NoBacklinksText" Text="Bağlantı yok" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontStyle="Italic" Visibility="Collapsed" VerticalAlignment="Center" />

                                            </DockPanel>

                                        </Border>

                                    </Grid>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>



                    <!-- VIEW 3: SettingsView (Theme preferences & settings) -->

                    <Grid x:Name="SettingsView" Visibility="Collapsed">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <!-- Header -->

                        <TextBlock Grid.Row="0" Text="Ayarlar" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="4,6,4,20" />



                        <!-- Settings Cards -->

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                            <StackPanel Margin="4,0">

                                <!-- Theme Selection Card -->

                                <Border Style="{StaticResource DashboardCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Görünüm ve Tema" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />

                                        <TextBlock Text="Uygulama temasını ve renk şemasını değiştirin." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,16" />

                                        

                                        <WrapPanel Margin="0,0,0,12">

                                            <Button Content="Koyu Tema" MinWidth="104" Margin="0,0,8,8" Click="DarkThemeButton_Click" />

                                            <Button Content="Aydınlık Tema" MinWidth="124" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Click="LightThemeButton_Click" />

                                        </WrapPanel>

                                        <RadioButton x:Name="DarkThemeRadio" Content="Karanlık Tema (Varsayılan)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" Margin="0,0,0,10" IsChecked="True" Checked="ThemeRadio_Checked" />

                                        <RadioButton x:Name="LightThemeRadio" Content="Aydınlık Tema" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" Checked="ThemeRadio_Checked" />

                                    </StackPanel>

                                </Border>



                                <!-- Notification Status Card -->

                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,16">

                                    <StackPanel>

                                        <TextBlock Text="Bildirim Servisi Durumu" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />

                                        <TextBlock Text="Windows bildirimlerini ve Outlook yedek akış durumunu buradan takip edebilirsiniz." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,16" />

                                        

                                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">

                                            <StackPanel>

                                                <!-- Status Indicator Row -->

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                                    <Ellipse x:Name="NotificationStatusDot" Width="12" Height="12" Fill="#778196" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                    <TextBlock x:Name="NotificationStatusText" Text="Bildirim servisi başlatılmadı." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                </StackPanel>

                                                

                                                <Separator Background="{DynamicResource BorderSoftBrush}" Margin="0,0,0,12" Height="1" />

                                                

                                                <!-- Stats Grid -->

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto" />

                                                        <ColumnDefinition Width="*" />

                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>

                                                        <RowDefinition Height="Auto" />

                                                        <RowDefinition Height="Auto" />

                                                    </Grid.RowDefinitions>

                                                    

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bugün Yakalanan:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />

                                                    <TextBlock x:Name="CapturedTodayCountText" Grid.Row="0" Grid.Column="1" Text="0 adet" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                                    

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Son Yakalanan:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,8,0,0" />

                                                    <TextBlock x:Name="LastNotificationTimeText" Grid.Row="1" Grid.Column="1" Text="Henüz bildirim yok" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0" />

                                                </Grid>

                                            </StackPanel>

                                        </Border>

                                        

                                        <WrapPanel>

                                            <Button Content="Bildirim İznini Aç" MinWidth="140" Height="30" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="RequestNotificationAccessButton_Click" />
                                            <Button Content="Gereksiz Bildirimleri Temizle" MinWidth="180" Height="30" Margin="0,0,8,0" Style="{StaticResource CompactActionButton}" Click="CleanOldNotificationsButton_Click" />

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>

                                <!-- Gemini CLI Setup Card -->
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Gemini CLI Kurulumu" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                                        <TextBlock Text="AI Analiz, Dikte ve Plan özellikleri için Gemini CLI'nin nasıl kurulacağını ve Google oturumunun nasıl açılacağını buradan tekrar görebilirsiniz." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,16" TextWrapping="Wrap" />

                                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Ellipse x:Name="GeminiCliStatusDot" Width="12" Height="12" Fill="#778196" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="GeminiCliStatusText" Text="Gemini CLI durumu kontrol edilmedi." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Stabil öneri: resmi npm paketini kullanın, sahte paketlerden kaçınmak için paket adını tam yazın: @google/gemini-cli"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel>
                                            <Button Content="Gemini Rehberini Aç" MinWidth="160" Height="30" Margin="0,0,8,0" Style="{StaticResource CompactActionButton}" Click="OpenGeminiOnboardingButton_Click" />
                                            <Button Content="Durumu Yenile" MinWidth="112" Height="30" Margin="0,0,8,0" Style="{StaticResource CompactActionButton}" Click="RefreshGeminiStatusButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Google Calendar Status Card -->
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Google Takvim Durumu" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                                        <TextBlock Text="Google Takvim senkronizasyonunu ve bağlantı durumunu buradan takip edebilirsiniz." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,16" />
                                        
                                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                            <StackPanel>
                                                <!-- Status Indicator Row -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Ellipse x:Name="CalendarStatusDot" Width="12" Height="12" Fill="#778196" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="CalendarStatusText" Text="Takvim henüz kontrol edilmedi." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                
                                                <Separator Background="{DynamicResource BorderSoftBrush}" Margin="0,0,0,12" Height="1" />
                                                
                                                <!-- Stats Grid -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Son Güncelleme:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="LastCalendarSyncTimeText" Grid.Row="0" Grid.Column="1" Text="Henüz senkronize edilmedi" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Eşleşen Etkinlik:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,8,0,0" />
                                                    <TextBlock x:Name="CalendarEventsCountText" Grid.Row="1" Grid.Column="1" Text="0 adet" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        
                                        <WrapPanel>
                                            <Button Content="Takvimi Şimdi Eşitle" MinWidth="180" Height="30" Margin="0,0,8,0" Style="{StaticResource CompactActionButton}" Click="SyncCalendarButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- About Card -->

                                <Border Style="{StaticResource DashboardCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Uygulama Hakkında" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                                        <TextBlock Text="QuickNote - Yapay Zeka Destekli Premium Kişisel Not Defteri." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />

                                        <TextBlock Text="Versiyon: 1.2.0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" />

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>



                </Grid>

            </Grid>



            <!-- Embedded Daily Summary Panel overlay (optional, but keep it in overlay row if needed, otherwise hidden) -->

            <Border Grid.Row="2"

                    x:Name="DailySummaryPanel"

                    Background="{DynamicResource BgDeepBrush}"

                    Visibility="Collapsed"

                    Margin="18,4,18,18">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>



                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">

                        <Button DockPanel.Dock="Right"

                                Content="Kapat"

                                MinWidth="72"

                                Height="28"

                                Click="CloseDailySummaryButton_Click" />

                        <TextBlock x:Name="DailySummaryTitle"

                                   Text="Günlük Özet"

                                   Foreground="{DynamicResource TextPrimaryBrush}"

                                   FontSize="16"

                                   FontWeight="SemiBold"

                                   VerticalAlignment="Center"/>

                    </DockPanel>



                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="0,0,10,0">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                <TextBlock x:Name="DailySummaryDateText"

                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                           FontSize="12"

                                           FontWeight="SemiBold" />

                                <TextBlock Text="  &#x2022;  " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />

                                <TextBlock x:Name="DailySummaryNotesCountText"

                                           Foreground="{DynamicResource TextMutedBrush}"

                                           FontSize="12" />

                                <TextBlock Text="  &#x2022;  " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />

                                <TextBlock x:Name="DailySummaryNotificationsCountText"

                                           Foreground="{DynamicResource TextMutedBrush}"

                                           FontSize="12" />

                            </StackPanel>



                            <!-- Gemini Daily Summary text -->

                            <Border Background="{DynamicResource BgCardBrush}"

                                    BorderBrush="{DynamicResource BorderSoftBrush}"

                                    BorderThickness="1"

                                    CornerRadius="10"

                                    Padding="14"

                                    Margin="0,0,0,14">

                                <TextBlock x:Name="DailySummaryText"

                                           Text="Özet oluşturuluyor..."

                                           Foreground="{DynamicResource TextPrimaryBrush}"

                                           FontSize="13.5"

                                           TextWrapping="Wrap"

                                           LineHeight="20" />

                            </Border>



                            <TextBlock Text="Bugünün Notları"

                                       Foreground="{DynamicResource TextSecondaryBrush}"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       Margin="0,0,0,8" />



                            <ItemsControl x:Name="DailySummaryNotesList" Margin="0,0,0,14">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="{DynamicResource BgCardBrush}"

                                                BorderBrush="{DynamicResource BorderSoftBrush}"

                                                BorderThickness="1"

                                                CornerRadius="8"

                                                Padding="12"

                                                Margin="0,0,0,8">

                                            <Grid>

                                                <Grid.RowDefinitions>

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"

                                                           Text="{Binding Title}"

                                                           Foreground="{DynamicResource TextPrimaryBrush}"

                                                           FontSize="13"

                                                           FontWeight="SemiBold" />

                                                <TextBlock Grid.Row="1"

                                                           Text="{Binding TextPreview}"

                                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                                           FontSize="12"

                                                           TextWrapping="Wrap"

                                                           Margin="0,4,0,4" />

                                                <TextBlock Grid.Row="2"

                                                           Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}"

                                                           Foreground="{DynamicResource TextMutedBrush}"

                                                           FontSize="10.5" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>



                            <TextBlock Text="Günün Bildirimleri"

                                       Foreground="{DynamicResource TextSecondaryBrush}"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       Margin="0,0,0,8" />



                            <ItemsControl x:Name="DailySummaryNotificationsList">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="{DynamicResource BgCardBrush}"

                                                BorderBrush="{DynamicResource BorderSoftBrush}"

                                                BorderThickness="1"

                                                CornerRadius="8"

                                                Padding="12"

                                                Margin="0,0,0,8">

                                            <Grid>

                                                <Grid.RowDefinitions>

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                    <RowDefinition Height="Auto" />

                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"

                                                           Text="{Binding AppName}"

                                                           Foreground="{DynamicResource AccentCyanBrush}"

                                                           FontSize="13"

                                                           FontWeight="SemiBold" />

                                                <TextBlock Grid.Row="1"

                                                           Text="{Binding Title}"

                                                           Foreground="{DynamicResource TextPrimaryBrush}"

                                                           FontSize="12.5"

                                                           FontWeight="SemiBold"

                                                           TextWrapping="Wrap"

                                                           Margin="0,4,0,2" />

                                                <TextBlock Grid.Row="2"

                                                           Text="{Binding Body}"

                                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                                           FontSize="12"

                                                           TextWrapping="Wrap"

                                                           Margin="0,0,0,4" />

                                                <TextBlock Grid.Row="3"

                                                           Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm}}"

                                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                                           FontSize="10.5" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>



            <!-- Overlay Detail Modal dialog -->

            <Grid x:Name="NoteDetailsModal"

                  Grid.Row="1" Grid.RowSpan="2"

                  Background="#A0000000"

                  Visibility="Collapsed">

                <Border Background="{DynamicResource BgPanelBrush}"

                        BorderBrush="{DynamicResource BorderSoftBrush}"

                        BorderThickness="1"

                        CornerRadius="14"

                        Width="600"

                        MaxHeight="500"

                        HorizontalAlignment="Center"

                        VerticalAlignment="Center">

                    <Grid Margin="20">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">

                            <Button DockPanel.Dock="Right"

                                    Content="X"

                                    FontSize="14"

                                    Style="{StaticResource IconButton}"

                                    Width="32"

                                    Height="32"

                                    MinWidth="32"

                                    Click="CloseModalButton_Click" />

                            <TextBlock x:Name="ModalTitle"

                                       Text="Not Detayı"

                                       Foreground="{DynamicResource TextPrimaryBrush}"

                                       FontSize="16"

                                       FontWeight="SemiBold"

                                       VerticalAlignment="Center" />

                        </DockPanel>



                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                            <StackPanel Margin="0,4,10,4">

                                <TextBlock x:Name="ModalBody"

                                           Text="İçerik yükleniyor..."

                                           Foreground="{DynamicResource TextSecondaryBrush}"

                                           FontSize="14"

                                           TextWrapping="Wrap"

                                           LineHeight="22" />

                                <Image x:Name="ModalImage"

                                       Margin="0,16,0,0"

                                       MaxWidth="560"

                                       MaxHeight="300"

                                       Stretch="Uniform"

                                       HorizontalAlignment="Left"

                                       Visibility="Collapsed" />

                            </StackPanel>

                        </ScrollViewer>



                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>



