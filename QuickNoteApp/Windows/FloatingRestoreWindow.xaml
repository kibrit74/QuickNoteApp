<Window x:Class="QuickNoteApp.Windows.FloatingRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatingRestoreWindow"
        Width="68" Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    
    <Grid>
        <Border x:Name="RestoreButton"
                Width="50" Height="50"
                CornerRadius="25"
                Background="#D01C1F28"
                BorderBrush="#40FFFFFF"
                BorderThickness="1.5"
                Cursor="Hand"
                MouseLeftButtonDown="RestoreButton_MouseLeftButtonDown"
                MouseMove="RestoreButton_MouseMove"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseLeftButtonUp="RestoreButton_MouseLeftButtonUp"
                MouseRightButtonUp="RestoreButton_MouseRightButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
                <TextBlock x:Name="IconText"
                           Text="⚡"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
